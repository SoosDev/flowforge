{
  "name": "flowforge",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": ">=22.0.0", "pnpm": ">=9.0.0" },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "test": "pnpm --recursive --filter './packages/*' test && pnpm --recursive --filter './apps/*' test",
    "typecheck": "pnpm --recursive typecheck"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "msgpackr-extract", "protobufjs"],
    "ignoredBuiltDependencies": ["protobufjs"]
  }
}
